FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="Lucid Team <support@lucid.com>"
LABEL description="Lucid AI Routing Service - AI model routing and orchestration"
LABEL version="1.3.0"
LABEL com.lucid.service="ai-routing-service"

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

RUN apk --no-cache add curl

COPY target/lucid-ai-routing-service-*.jar app.jar

RUN chown -R appuser:appgroup /app

ENV JAVA_OPTS=""
ENV SERVER_PORT=8083

EXPOSE 8083

USER appuser

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8083/actuator/health || exit 1
